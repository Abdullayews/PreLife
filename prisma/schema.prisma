// Prisma 7 schema. The connection URL lives in prisma.config.ts (CLI)
// and in the PrismaClient adapter (runtime, src/lib/db.ts) — the schema
// only declares the provider. Client code is generated to
// src/generated/prisma by `bun run db:push` / `bun run db:generate`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
