// Prisma 7 schema. The connection URL lives in prisma.config.ts (CLI)
// and in the PrismaClient adapter (runtime, src/lib/db.ts) — the schema
// only declares the provider. Client code is generated to
// src/generated/prisma by `bun run db:push` / `bun run db:generate`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

/** One row per signed-in device (Settings → Devices). The cookie carries
 *  a random token; only its SHA-256 hash is stored. Expiry slides forward
 *  on activity, so an active user is never signed out automatically. */
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  deviceName String
  deviceIcon String   @default("monitor")
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
}
