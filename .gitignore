# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# local runtime artifacts — not part of the app (db/.gitkeep IS tracked
# so the SQLite fallback path exists on fresh checkouts)
/src/generated/
/Caddyfile
/.zscripts/
/download/
/prelife-preview/
/tests/
/examples/
# mini-services: platform scratch services are ignored, but the PreLife
# Rust backend IS the product's backend — keep it tracked.
/mini-services/*
!/mini-services/prelife-api/
/tool-results/
/upload/

# local working notes — kept out of the repo
/refs/
/scripts/qa/
/worklog.md
/scripts/gh_check.py
# runtime state (seeded idempotently at runtime)
db/*.db
.zscripts/dev.pid
.zshots/

# secrets
.env
.env.local

# rust
mini-services/prelife-api/target/
