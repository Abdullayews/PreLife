# Prisma datasource — SQLite file in the repo's db/ folder.
# Copy this file to .env. Paths resolve against the working directory
# (the repo root when running npm run dev / npm start).
# On hosts with ephemeral storage (e.g. Render), point this at a
# persistent disk instead, e.g. file:/var/data/custom.db
DATABASE_URL=file:./db/custom.db
