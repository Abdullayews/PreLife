# PreLife — environment template. Copy to .env and fill in.

# ── Supabase (the single source of truth: content + i18n + user data) ──────
SUPABASE_URL=https://zfoafweipekpuqsfsype.supabase.co
SUPABASE_PROJECT_REF=zfoafweipekpuqsfsype
# Management API personal access token (sbp_…) — used by scripts/apply-db.mjs
SUPABASE_ACCESS_TOKEN=
# service_role key — used by the RUST BACKEND (mini-services/prelife-api),
# which serves every /api/* route in production.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin (metadata/OG URLs). The live site runs on Render:
NEXT_PUBLIC_SITE_URL=https://prelife.onrender.com

# Production deployment: see .env.production.example (Render).

# ── Outgoing e-mail (Brevo relay) ───────────────────────────────────────────
# Primary: Brevo HTTP API — set BREVO_API_KEY and mails go out through
# api.brevo.com (sender no-reply@prelife.net is already domain-verified).
# The key lives at brevo.com → SMTP & API → API keys (v3, xkeysib-…).
# Alternative: plain SMTP (SMTP_HOST/USER/PASS via nodemailer). When
# neither is set (bare dev), messages fall back to the mail_outbox table.
BREVO_API_KEY=
MAIL_FROM=PreLife <no-reply@prelife.net>
# SMTP alternative (optional):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── The Rust backend (mini-services/prelife-api, port 3030) ────────────────
# Dev sandbox: the in-process Supabase emulator + the gateway query param.
SUPABASE_EMU=1
API_TRANSFORM_PORT=3030
NEXT_PUBLIC_API_TRANSFORM_PORT=3030
API_INTERNAL_URL=http://127.0.0.1:3030
# Production leaves the three *_TRANSFORM/INTERNAL vars unset — a reverse
# proxy routes /api/* to the service (see mini-services/prelife-api/README).
