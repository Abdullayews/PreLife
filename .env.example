# PreLife — environment template. Copy to .env and fill in.

# ── Supabase (the single source of truth: content + i18n + user data) ──────
SUPABASE_URL=https://zfoafweipekpuqsfsype.supabase.co
SUPABASE_PROJECT_REF=zfoafweipekpuqsfsype
# Management API personal access token (sbp_…) — used by scripts/apply-db.mjs
SUPABASE_ACCESS_TOKEN=
# service_role key — used by the merged Next.js backend (src/app/api/*)
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin (metadata/OG URLs). The live site runs on Render:
NEXT_PUBLIC_SITE_URL=https://prelife.onrender.com

# Production deployment: see .env.production.example (Render).

# ── Outgoing e-mail (Brevo SMTP relay) ──────────────────────────────────────
# When SMTP_HOST/USER/PASS are set, mails go out through nodemailer; when
# empty (sandbox/dev), every message falls back to the mail_outbox table.
# Brevo setup: brevo.com → SMTP & API → create an SMTP key (xkeysib-…),
# then verify the sending domain (prelife.net) with the DNS records Brevo
# shows you (SPF + DKIM) at the domain's DNS panel.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PreLife <no-reply@prelife.net>
