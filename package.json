{
  "name": "prelife",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log & node scripts/warm.mjs; wait",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production HOSTNAME=0.0.0.0 node --env-file-if-exists=.env.production .next/standalone/server.js",
    "lint": "oxlint . && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:export": "bun scripts/export-content.mjs",
    "db:apply": "node scripts/apply-db.mjs",
    "db:apply:schema": "node scripts/apply-db.mjs schema"
  },
  "dependencies": {
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "z-ai-web-dev-sdk": "0.0.18"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.94.0",
    "typescript": "npm:@tsc-rs/typescript@0.8.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "@parcel/watcher",
    "typescript",
    "@tsc-rs/typescript",
    "oxlint"
  ],
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "typescript": true,
    "@tsc-rs/typescript": true,
    "oxlint": true
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
