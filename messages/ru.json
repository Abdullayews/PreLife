      "heroText": "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0435 \u043f\u043b\u0430\u043d\u044b \u043f\u0438\u0442\u0430\u043d\u0438\u044f, \u0447\u0435\u0441\u0442\u043d\u044b\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u044b, \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0435 \u0434\u043e\u0432\u0435\u0440\u0438\u044f \u0434\u0438\u0435\u0442\u043e\u043b\u043e\u0433\u0438 \u0438 \u0432\u0438\u0434\u0435\u043e, \u0433\u0434\u0435 \u0445\u043e\u0440\u043e\u0448\u0430\u044f \u0435\u0434\u0430 \u2014 \u044d\u0442\u043e \u043b\u0435\u0433\u043a\u043e. \u0418\u0418 \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u0438\u0442 \u043f\u043b\u0430\u043d \u043f\u043e\u0434 \u0432\u0430\u0441.",
      "ctaTitle": "\u0417\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u0440\u0438\u0451\u043c \u043f\u0438\u0449\u0438",
      "ctaText": "\u041e\u0434\u043d\u0430 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0442\u0430\u0440\u0435\u043b\u043a\u0430 \u2014 \u0443\u0436\u0435 \u043e\u0442\u043b\u0438\u0447\u043d\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e.",
