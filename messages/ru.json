      "heroText": "\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0434\u043b\u044f \u0437\u0430\u043b\u0430, \u0439\u043e\u0433\u0430-\u043f\u043e\u0442\u043e\u043a\u0438, \u043f\u0438\u043b\u0430\u0442\u0435\u0441, \u043b\u0438\u0447\u043d\u044b\u0435 \u0442\u0440\u0435\u043d\u0435\u0440\u044b \u0438 \u0432\u0438\u0434\u0435\u043e\u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438 \u2014 \u0430 PreLife \u0418\u0418 \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442 \u043d\u0435\u0434\u0435\u043b\u044e \u043f\u043e\u0434 \u0432\u0430\u0448\u0443 \u044d\u043d\u0435\u0440\u0433\u0438\u044e.",
      "ctaTitle": "\u041f\u0435\u0440\u0432\u0430\u044f \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430 \u0443\u0436\u0435 \u0436\u0434\u0451\u0442",
      "ctaText": "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u0438 \u043f\u044f\u0442\u0438 \u043c\u0438\u043d\u0443\u0442 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0434\u043b\u044f \u0441\u0442\u0430\u0440\u0442\u0430.",
      "subs": {
