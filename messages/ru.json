      "heroText": "\u0420\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u044b \u0441 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430\u043c\u0438, \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0435 \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438, \u043e\u0431\u0443\u0447\u0430\u044e\u0449\u0438\u0435 \u0432\u0438\u0434\u0435\u043e \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 PreLife \u0418\u0418 \u043c\u0435\u0436\u0434\u0443 \u0441\u0435\u0441\u0441\u0438\u044f\u043c\u0438 \u2014 \u0432\u0441\u0451 \u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u0432 \u043e\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435.",
      "ctaTitle": "\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0440\u0430\u0431\u043e\u0442\u0443",
      "ctaText": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0442\u0440\u0451\u0445 \u0442\u0438\u0445\u0438\u0445 \u043c\u0438\u043d\u0443\u0442.",
      "subs": {
        "psikoloqlar": "\u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438",
