      "items": {
        "0": {
          "title": "5 \u043c\u0438\u043d\u0443\u0442 \u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 \u0442\u0438\u0448\u0438\u043d\u044b",
          "desc": "\u041a\u043e\u0440\u043e\u0442\u043a\u0430\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u0430\u044f \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u0434\u0435\u043d\u044c \u0431\u0435\u0437 \u0441\u043f\u0435\u0448\u043a\u0438, \u2014 \u043e\u043d\u0430 \u0437\u0430\u0434\u0430\u0451\u0442 \u0442\u043e\u043d \u0432\u0441\u0435\u043c\u0443 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u043c\u0443."
        },
        "1": {
          "title": "Aynur Mammadova",
          "desc": "\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433, 12 \u043b\u0435\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438. \u041e\u043d\u043b\u0430\u0439\u043d-\u0441\u0435\u0441\u0441\u0438\u0438 \u043f\u043e \u0442\u0440\u0435\u0432\u043e\u0436\u043d\u043e\u0441\u0442\u0438, \u0441\u0442\u0440\u0435\u0441\u0441\u0443 \u0438 \u0432\u044b\u0433\u043e\u0440\u0430\u043d\u0438\u044e."
        },
        "2": {
          "title": "\u041f\u043e\u043d\u044f\u0442\u044c \u0432\u044b\u0433\u043e\u0440\u0430\u043d\u0438\u0435",
          "desc": "\u0421\u0435\u0440\u0438\u044f \u0438\u0437 \u0447\u0435\u0442\u044b\u0440\u0451\u0445 \u0432\u0438\u0434\u0435\u043e \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u044b\u0433\u043e\u0440\u0430\u043d\u0438\u0435 \u0438 \u043a\u0430\u043a\u0438\u0435 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0435\u0433\u043e \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442."
        },
        "3": {
          "title": "\u0421\u043f\u0440\u043e\u0441\u0438\u0442\u0435 PreLife \u0418\u0418",
          "desc": "\u0418\u0418-\u043a\u043e\u043c\u043f\u0430\u043d\u044c\u043e\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442\u0441\u044f \u0432\u0430\u0448\u0438\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u043c, \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043e\u0441\u0443\u0436\u0434\u0430\u0435\u0442."
        }
      }
    },
    "kitab": {
      "name": "\u041a\u043d\u0438\u0433\u0438",
      "heroTitle": "\u0427\u0438\u0442\u0430\u0439\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0441\u0442\u0438.",
      "heroText": "\u0411\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430 \u0441 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430\u043c\u0438 \u043d\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u0435\u0437\u043e\u043d \u0436\u0438\u0437\u043d\u0438 \u2014 \u0438 \u0432\u044b\u0431\u043e\u0440 \u0418\u0418, \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u043c \u043f\u043e\u0434 \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0442\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441.",
      "ctaTitle": "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u0433\u043b\u0430\u0432\u0443",
      "ctaText": "\u041e\u0434\u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0432 \u0434\u0435\u043d\u044c \u0443\u0436\u0435 \u043c\u0435\u043d\u044f\u0435\u0442 \u0433\u043e\u0434.",
      "subs": {
        "kitablar": "\u041a\u043d\u0438\u0433\u0438",
