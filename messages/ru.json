      },
      "items": {
        "0": {
          "title": "\u0410\u0442\u043e\u043c\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438",
          "desc": "\u0414\u0436\u0435\u0439\u043c\u0441 \u041a\u043b\u0438\u0440. \u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u2014 \u0441\u043f\u0443\u0442\u043d\u0438\u043a \u043f\u043e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0430 PreLife."
        },
        "1": {
          "title": "\u0421\u0438\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e",
          "desc": "\u042d\u043a\u0445\u0430\u0440\u0442 \u0422\u043e\u043b\u043b\u0435. \u041f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u0430\u043a \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u2014 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u0430\u0440\u0430 \u043a \u0440\u0430\u0437\u0434\u0435\u043b\u0443 \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438."
        },
        "2": {
          "title": "\u0413\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430",
          "desc": "\u041a\u044d\u043b \u041d\u044c\u044e\u043f\u043e\u0440\u0442. \u0424\u043e\u043a\u0443\u0441 \u0432 \u043c\u0438\u0440\u0435 \u043e\u0442\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439 \u2014 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0432\u0430\u0441 \u0432\u043f\u0435\u0440\u0451\u0434."
        },
        "3": {
          "title": "\u041f\u043e\u0434\u0431\u043e\u0440\u043a\u0438 \u0418\u0418 \u043f\u043e\u0434 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435",
          "desc": "\u0420\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435 PreLife \u0418\u0418, \u043a\u0430\u043a \u0441\u0435\u0431\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435, \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0442\u0440\u0438 \u043a\u043d\u0438\u0433\u0438 \u043f\u043e\u0434 \u044d\u0442\u0443 \u0441\u0430\u043c\u0443\u044e \u043d\u0435\u0434\u0435\u043b\u044e \u0436\u0438\u0437\u043d\u0438."
        }
      }
    },
