        "1": {
          "title": "\u0423\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u0439\u043e\u0433\u0430-\u043f\u043e\u0442\u043e\u043a",
          "desc": "\u041f\u044f\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u044c \u043c\u044f\u0433\u043a\u0438\u0445 \u043c\u0438\u043d\u0443\u0442, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044c \u0441\u043f\u0438\u043d\u0443 \u0438 \u0431\u0451\u0434\u0440\u0430 \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0434\u043d\u044f."
        },
        "2": {
          "title": "\u041f\u0438\u043b\u0430\u0442\u0435\u0441: \u0431\u0430\u0437\u0430 \u043a\u043e\u0440\u0430",
          "desc": "\u041a\u043e\u0432\u0440\u0438\u043a, \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u043c\u0438\u043d\u0443\u0442 \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0436\u0436\u0435\u043d\u0438\u0435 \u2014 \u043e\u0441\u043d\u043e\u0432\u0430 \u0432\u0441\u0435\u0433\u043e \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e."
